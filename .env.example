# ==============================================================================
# SYED AMAN PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` and fill in your values.
# NEVER commit real secret credentials or API keys to version control.
# ==============================================================================

# GitHub Username for fetching repositories dynamically
VITE_GITHUB_USERNAME=your_github_username

# ------------------------------------------------------------------------------
# CONTACT FORM EMAIL INTEGRATION (Pick any ONE provider)
# ------------------------------------------------------------------------------

# Option A: Web3Forms (Recommended - free, no server required)
# Get a free access key at https://web3forms.com (delivered to your email)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Option B: Formspree (Alternative provider)
# Create a form at https://formspree.io and paste your Form ID or endpoint
# VITE_FORMSPREE_ID=your_formspree_form_id

# Option C: EmailJS (Alternative provider)
# Configure an email service at https://emailjs.com
# VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
